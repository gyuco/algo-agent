generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connections ProviderConnection[]
  projects    Project[]
  missions    Mission[]
  resources   Resource[]
  runs        Run[]
  secrets     Secret[]
}

/// A user's connection to an agent provider (Claude Code, OpenCode, ...).
model ProviderConnection {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Provider id: "claude" or "opencode"
  provider        String
  /// How it connects. claude: "api_key" (ANTHROPIC_API_KEY) or "oauth_token" (CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`); opencode: "local"
  method          String
  /// Null for methods that use credentials already on the machine.
  secretEncrypted String?
  secretHint      String?
  /// Provider-specific state (JSON), e.g. Claude's last plan rate-limit snapshot.
  stateJson       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, provider])
}

model Project {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Absolute local folder, resolved (symlinks followed) and inside WORKSPACE_ROOT.
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources ProjectResource[]
  runs      Run[]
  missions  Mission[]
  secrets   Secret[]
  /// Resources defined for this project only.
  own       Resource[]

  @@unique([userId, path])
  @@index([userId])
}

/// A mission: an orchestrator interviews the user, proposes a plan and, from phase 2, runs it.
model Mission {
  id                Int       @id @default(autoincrement())
  projectId         Int
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  /// "briefing", "planned", "approved", "running", "waiting", "aborted".
  status            String
  /// "step" or "auto".
  mode              String
  input             String
  planJson          String?
  planVersion       Int       @default(0)
  approvedVersion   Int?
  orchestratorModel String
  sessionId         String?
  /// Chat conversation this mission was born from (`<provider>:<id>`).
  fromSession       String?
  /// Null when the project isn't a git repository: the mission can't start.
  baseBranch        String?
  /// The commit the mission's branch started from: the perimeter and the PR measure from it.
  baseCommit        String?
  branch            String?
  worktreePath      String?
  prUrl             String?
  waitJson          String?
  budgetJson        String    @default("{}")
  costUsd           Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  approvedAt        DateTime?
  finishedAt        DateTime?
  seenAt            DateTime?

  tasks   MissionTask[]
  entries MissionEntry[]
  runs    Run[]

  @@index([projectId])
  @@index([userId, status])
  @@index([sessionId])
}

/// A task of the plan, with the state it has while the mission runs.
model MissionTask {
  id           Int       @id @default(autoincrement())
  missionId    Int
  mission      Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// Id of the task in the plan, unique in the mission.
  key          String
  milestone    String
  /// "pending", "running", "review", "merging", "blocked", "done", "skipped" or "aborted".
  status       String    @default("pending")
  branch       String?
  worktreePath String?
  /// The commit this attempt started from: the task's diff measures from it.
  taskBase     String?
  runId        Int?
  attempts     Int       @default(0)
  notesJson    String    @default("[]")
  reportJson   String?
  startedAt    DateTime?
  finishedAt   DateTime?

  runs    Run[]
  entries MissionEntry[]

  @@unique([missionId, key])
  @@index([missionId])
}

/// The mission's append-only log: status changes, plan versions, questions, notes.
model MissionEntry {
  id        Int         @id @default(autoincrement())
  missionId Int
  mission   Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  taskId    Int?
  task      MissionTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// "status", "turn", "question", "decision", "wait", "resume", "note", "plan", "budget", "pr", "error".
  kind      String
  notify    Boolean     @default(false)
  dataJson  String
  createdAt DateTime    @default(now())

  @@index([missionId])
}

/// A user's resource (agent, MCP server, skill or workflow): in their library, usable in all their projects, or in one project only.
model Resource {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null: in the library. A key is unique across the library and all the user's projects.
  projectId        Int?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "agent", "mcp", "skill" or "workflow"
  kind             String
  key              String
  /// Definition (JSON) validated by the catalog schema of its kind; an MCP server's env and headers are left out.
  specJson         String
  /// MCP env and headers (JSON), encrypted: they often hold tokens.
  secretsEncrypted String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, kind, key])
}

/// A named secret that MCP servers refer to as `${NAME}` in their env or headers; a project's secret overrides the user's one of the same name.
model Secret {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null: the user's, for all their projects.
  projectId      Int?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  /// Encrypted and bound to its user, project and name.
  valueEncrypted String
  /// Last characters of the value, to tell secrets apart.
  hint           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// SQLite treats NULLs as distinct: the service keeps the user's own secrets unique.
  @@unique([userId, projectId, name])
}

/// A catalog resource switched on or off in one project; without a row the catalog's enabledByDefault applies.
model ProjectResource {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "agent", "tool", "mcp", "skill" or "workflow"
  kind      String
  /// Key of the resource in the catalog.
  key       String
  enabled   Boolean

  @@unique([projectId, kind, key])
}

/// A workflow run or a chat turn, executed in the background: it outlives the request that started it.
model Run {
  id           Int       @id @default(autoincrement())
  projectId    Int
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "workflow", "chat", "mission-orchestrator" or "mission-task"
  kind         String    @default("workflow")
  /// "queued", "running", "waiting", "done", "failed", "aborted" or "interrupted"
  status       String
  /// "manual", "schedule" or "webhook"
  trigger      String    @default("manual")
  /// Shown in lists: the workflow's key, or the chat message cut short.
  title        String    @default("")
  /// What the user typed: the workflow's input or the chat message.
  input        String
  /// Key of the workflow in the catalog (workflow runs only).
  workflow     String?
  /// Hash of the workflow's definition when the run was created, to refuse resuming a changed one.
  workflowHash String?
  /// Chat only: the conversation (`<provider>:<id>`); null until the provider assigns it.
  sessionId    String?
  /// Chat only: catalog agent that answers; null chats with the model directly.
  agent        String?
  /// Chat only: `<provider>:<model>` chosen for the turn.
  model        String?
  /// Chat only: effort level chosen for the turn, among the model's; null: the model's default.
  effort       String?
  /// Provider expected to run it, to hold it back while that provider's limit is reached.
  provider     String?
  /// Whether some agent of the run may write files in the project folder.
  writes       Boolean   @default(false)
  /// Mission orchestrator turn or mission task this run belongs to.
  missionId     Int?
  mission       Mission?     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  missionTaskId Int?
  missionTask   MissionTask? @relation(fields: [missionTaskId], references: [id], onDelete: SetNull)
  /// Steps run so far (JSON): [{ agent, output, isError }]
  stepsJson    String    @default("[]")
  /// A task run's graph frozen when it starts (JSON).
  specJson     String?
  costUsd      Float     @default(0)
  error        String?
  /// Run this one resumes.
  resumeOf     Int?
  startedAt    DateTime?
  /// Refreshed while the run executes; a stale one means its process died.
  heartbeatAt  DateTime?
  finishedAt   DateTime?
  /// Last time the user opened it: a run finished after this is unread.
  seenAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events RunEvent[]

  @@index([projectId])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([sessionId])
  @@index([missionId])
  @@index([missionTaskId])
  @@map("WorkflowRun")
}

/// Every event a run emitted, in order, so a client can catch up on it at any time.
model RunEvent {
  id        Int      @id @default(autoincrement())
  runId     Int
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// 1, 2, 3... within the run: the cursor clients resume from.
  seq       Int
  dataJson  String
  createdAt DateTime @default(now())

  @@unique([runId, seq])
}
