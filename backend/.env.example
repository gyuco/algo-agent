DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"
# Registration is always open while no user exists; set to true to keep it open afterwards.
ALLOW_REGISTRATION="false"
CORS_ORIGIN="http://localhost:5173"
# Google sign-in (optional): an email that already has an account can also sign in with Google.
# Create an OAuth client of type "Web application" and register the redirect URI
#   http://localhost:5173/api/auth/google/callback
# Without both values the Google button isn't shown.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Only needed when it differs from CORS_ORIGIN + /api/auth/google/callback.
# GOOGLE_REDIRECT_URI="http://localhost:5173/api/auth/google/callback"
# 32-byte hex key used to encrypt stored Anthropic API keys: openssl rand -hex 32
ENCRYPTION_KEY="change-me"
# Single-user local mode: binds to 127.0.0.1 and lets the app owner (first user) connect a Claude Pro/Max subscription via `claude setup-token`.
PERSONAL_MODE="true"
# Claude Code CLI used for `claude setup-token`.
CLAUDE_BIN="claude"
# Chat working directories must be inside this folder (default: home directory).
WORKSPACE_ROOT=""
# Folder with the example resources offered by "Importa esempi" (default: ./catalog).
CATALOG_DIR=""
