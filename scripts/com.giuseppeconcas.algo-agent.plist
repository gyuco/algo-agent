<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.giuseppeconcas.algo-agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/giuseppeconcas/workspace/algo-agent/scripts/start-prod.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/giuseppeconcas/workspace/algo-agent/backend</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/giuseppeconcas</string>
    <key>PATH</key>
    <string>/Users/giuseppeconcas/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/giuseppeconcas/Library/Logs/algo-agent/backend.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/giuseppeconcas/Library/Logs/algo-agent/backend.error.log</string>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
